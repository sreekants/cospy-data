# No anchoring - restricted or precautionary area Bremen.PrecautionaryArea.1 (osm:way/567011986)
clause['Bremen.PrecautionaryArea.1.NoAnchoring']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Bremen.PrecautionaryArea.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Status not in [Vessel.Status.ANCHORED]
            }
    }
}

# No fishing - restricted or precautionary area Bremen.PrecautionaryArea.1 (osm:way/567011986)
clause['Bremen.PrecautionaryArea.1.NoFishing']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Bremen.PrecautionaryArea.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true) and (OwnShip.Operation in [Vessel.Operation.FISHING])
            }
        assure: {
            :(OwnShip,TrafficSeparationScheme).InRange == false
            }
    }
}

