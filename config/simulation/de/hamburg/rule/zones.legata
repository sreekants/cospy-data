# Speed limit 10 kn (5.14 m/s) - harbour Hamburg.Harbour
clause['Hamburg.Harbour.Speed']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Hamburg.Harbour.1', 'Hamburg.Harbour.2', 'Hamburg.Harbour.3', 'Hamburg.Harbour.4', 'Hamburg.Harbour.5', 'Hamburg.Harbour.6', 'Hamburg.Harbour.7', 'Hamburg.Harbour.8', 'Hamburg.Harbour.9', 'Hamburg.Harbour.10', 'Hamburg.Harbour.11', 'Hamburg.Harbour.12', 'Hamburg.Harbour.13', 'Hamburg.Harbour.14', 'Hamburg.Harbour.15', 'Hamburg.Harbour.16', 'Hamburg.Harbour.17', 'Hamburg.Harbour.18', 'Hamburg.Harbour.19', 'Hamburg.Harbour.20', 'Hamburg.Harbour.21', 'Hamburg.Harbour.22', 'Hamburg.Harbour.23', 'Hamburg.Harbour.24']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Velocity <= 5.14
            }
    }
}

