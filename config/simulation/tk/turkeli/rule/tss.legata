        assure: {
            :(OwnShip.Heading in angle(225, 315)) or (OwnShip.Heading in angle(345, 15)) or (OwnShip.Heading in angle(165, 195))
            }
    }
}

# Rule 10(g): avoid anchoring in Turkeli.TSS.Northbound.2
clause['Turkeli.TSS.Northbound.2.NoAnchoring']:{
