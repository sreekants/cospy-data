# Description:  Turkeli local rules - traffic separation scheme (COLREG Rule 10)
# Generated:    by .claude/skills/mapgen/legata_site.py from config/map/tk/turkeli/sea.s3db (MAPGEN §4.3); regenerate, do not edit
# Zone:         (OwnShip,TrafficSeparationScheme) is the zone the vessel is in, of the types the ZoneRule module in rules.yaml watches

# Rule 10(e): do not enter Turkeli.TSS.SeparationZone.1 except to cross, join or leave a lane, in an emergency, or to fish in it
clause['Turkeli.TSS.SeparationZone.1.Entry']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Turkeli.TSS.SeparationZone.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true) and (OwnShip.Operation not in [Vessel.Operation.FISHING])
            }
        assure: {
            :(OwnShip,TrafficSeparationScheme).InRange == false
            }
    }
}

# Rule 10(b)(i): proceed in Turkeli.TSS.Southbound.1 in its general direction of traffic flow (Southbound; simulator heading 90, 0 = east, y south) within 45 degrees; Rule 10(c): or cross it at right angles (within 15 degrees)
clause['Turkeli.TSS.Southbound.1.Direction']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Turkeli.TSS.Southbound.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true) and (OwnShip.Velocity > 0.5)
            }
        assure: {
            :(OwnShip.Heading in angle(45, 135)) or (OwnShip.Heading in angle(165, 195)) or (OwnShip.Heading in angle(345, 15))
            }
    }
}

# Rule 10(g): avoid anchoring in Turkeli.TSS.Southbound.1
clause['Turkeli.TSS.Southbound.1.NoAnchoring']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Turkeli.TSS.Southbound.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Status not in [Vessel.Status.ANCHORED]
            }
    }
}

# Speed limit 10 kn (5.14 m/s) in Turkeli.TSS.Southbound.1
clause['Turkeli.TSS.Southbound.1.Speed']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Turkeli.TSS.Southbound.1.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Velocity <= 5.14
            }
    }
}

# Rule 10(b)(i): proceed in Turkeli.TSS.Northbound.2 in its general direction of traffic flow (Northbound; simulator heading 270, 0 = east, y south) within 45 degrees; Rule 10(c): or cross it at right angles (within 15 degrees)
clause['Turkeli.TSS.Northbound.2.Direction']:{
