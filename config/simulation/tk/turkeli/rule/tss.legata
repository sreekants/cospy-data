        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Turkeli.TSS.Northbound.2.1']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Status not in [Vessel.Status.ANCHORED]
            }
    }
}

