            :((OwnShip,TrafficSeparationScheme).Name in ['Tautra.NatureReserve.Tautra.1', 'Tautra.NatureReserve.Tautra.2']) and ((OwnShip,TrafficSeparationScheme).InRange == true) and (OwnShip.Operation not in [Vessel.Operation.FISHING])
            }
        assure: {
