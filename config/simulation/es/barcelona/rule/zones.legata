    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Barcelona.Harbour.1', 'Barcelona.Harbour.2', 'Barcelona.Harbour.3', 'Barcelona.Harbour.4', 'Barcelona.Harbour.5', 'Barcelona.Harbour.6', 'Barcelona.Harbour.7']) and ((OwnShip,TrafficSeparationScheme).InRange == true) and (OwnShip.Operation in [Vessel.Operation.FISHING])
            }
