# Speed limit 6 kn (3.09 m/s) - harbour Barcelona.Harbour
clause['Barcelona.Harbour.Speed']:{
    : {
        condition: {
            :((OwnShip,TrafficSeparationScheme).Name in ['Barcelona.Harbour.1', 'Barcelona.Harbour.2', 'Barcelona.Harbour.3', 'Barcelona.Harbour.4', 'Barcelona.Harbour.5', 'Barcelona.Harbour.6', 'Barcelona.Harbour.7']) and ((OwnShip,TrafficSeparationScheme).InRange == true)
            }
        assure: {
            :OwnShip.Velocity <= 3.09
            }
    }
}

# No fishing - harbour Barcelona.Harbour
